{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.photos",
  "title": "Photos",
  "version": "0.2.0",
  "icon": "./icon.png",
  "applet": {
    "version": 1,
    "summary": "The photos the camera took."
  },
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary",
        "camera.photo"
      ],
      "enhances": [
        "system.agent"
      ]
    }
  },
  "app": {
    "entry": "photos/main.tsx",
    "output": "photos-main",
    "framework": "solid",
    "surfaces": {
      "auxiliary": {
        "adaptive": {
          "min": [
            320,
            240
          ],
          "max": [
            640,
            720
          ]
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [
          [
            400,
            240
          ],
          [
            512,
            384
          ]
        ],
        "presentation": "native"
      }
    }
  }
}
