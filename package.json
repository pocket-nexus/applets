{
  "name": "pocket-applets",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Pocket Applets: one source for every device that runs them, and the store at applets.pocket.nexus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pocket-nexus/applets.git"
  },
  "scripts": {
    "setup": "git submodule update --init vendor/pocketjs && bun install --frozen-lockfile && bun install --cwd vendor/pocketjs --frozen-lockfile && bun tools/setup.ts",
    "build": "bun tools/build.ts",
    "icons": "bun tools/icons/build.ts",
    "site": "vite store/site",
    "site:build": "vite build store/site",
    "typecheck": "bun vendor/pocketjs/node_modules/typescript/bin/tsc --noEmit",
    "typecheck:site": "vue-tsc --noEmit -p store/site/tsconfig.json",
    "test": "bun vendor/pocketjs/tools/wasm.ts && bun test --conditions=browser ./test ./lib ./tools ./store/test",
    "check": "bun run typecheck && bun run typecheck:site && bun run test"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.5.0",
    "vue-tsc": "3.3.14",
    "wrangler": "4.156.2"
  }
}
