{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "__ID__",
  "title": "__TITLE__",
  "version": "0.1.0",
  "icon": "./icon.png",
  "applet": {
    "version": 1,
    "summary": "__SUMMARY__",
    "services": [
      "store",
      "images",
      "glyphs"
    ],
    "hosts": []
  },
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary",
        "net.http"
      ],
      "enhances": [
        "input.analog.left",
        "system.agent"
      ]
    }
  },
  "app": {
    "entry": "__NAME__/main.tsx",
    "output": "__NAME__-main",
    "framework": "solid",
    "surfaces": {
      "auxiliary": {
        "adaptive": {
          "min": [
            320,
            240
          ],
          "max": [
            640,
            720
          ]
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [
          [
            400,
            240
          ],
          [
            512,
            384
          ]
        ],
        "presentation": "native"
      }
    }
  },
  "domains": {
    "worker": {
      "entry": "lib/net-worker.ts",
      "nodes": [
        {
          "name": "http",
          "kind": "http"
        }
      ],
      "channels": [
        {
          "name": "request",
          "kind": "ring",
          "direction": "ui-to-worker",
          "recordBytes": 1024,
          "capacity": 4
        },
        {
          "name": "response",
          "kind": "ring",
          "direction": "worker-to-ui",
          "recordBytes": 1024,
          "capacity": 8
        }
      ]
    }
  }
}
