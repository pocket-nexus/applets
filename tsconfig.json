{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "paths": {
      "@pocketjs/framework": ["./vendor/pocket-shell/vendor/pocketjs/framework/src/index.ts"],
      "@pocketjs/framework/solid": ["./vendor/pocket-shell/vendor/pocketjs/framework/src/index.ts"],
      "@pocketjs/framework/input": ["./vendor/pocket-shell/vendor/pocketjs/framework/src/input-api.ts"],
      "@pocketjs/framework/system-layers": ["./vendor/pocket-shell/vendor/pocketjs/framework/src/system-layers-api.ts"],
      "@pocketjs/framework/sim": ["./vendor/pocket-shell/vendor/pocketjs/programs/sim/sim.ts"],
      "@pocketjs/framework/*": ["./vendor/pocket-shell/vendor/pocketjs/framework/src/*"]
    }
  },
  "include": ["appstore", "camera", "discord", "github", "hn", "homeassistant", "maps", "notes", "photos", "podcasts", "spotify", "weather", "x", "youtube", "kit", "lib", "ui", "tools", "test"]
}
